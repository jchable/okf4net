tests/fixtures/** -text
bundles/acme_retail/** -text
bundles/ga4/** -text
docs/spec/SPEC.md -text

# The viewer's vendored fonts: the woff2 files and the OFL texts are recorded
# (size and sha256) in fonts/README.md, and ViewerFontsTests hashes the bytes
# OKF4net.Viewer embeds against that table. Without -text a Windows checkout
# (autocrlf) turns the stored-LF texts into CRLF, so Windows and Linux builds
# embed different bytes and that test fails. The README itself is not hashed.
src/OKF4net.Viewer/Assets/fonts/** -text

# Shell scripts run via `sh` (or piped straight into it, e.g.
# packaging/install.sh via curl) need LF endings, not the CRLF a Windows
# contributor's autocrlf=true checkout would otherwise apply -- a `\r` inside
# a case pattern or before a keyword is enough to break dash/bash parsing.
# Force LF in both directions regardless of local git config.
*.sh text eol=lf

# The producer's golden bundle and the fixture repository it is generated from are compared BYTE FOR
# BYTE by `producers/tests/OkfProducer.Tests/Generation/CheckTests.cs`. Without -text, git would
# translate line endings on checkout and the comparison would fail on a fresh clone for a reason no
# diff of those files would show. `producers/` is outside CI, so nothing else would catch it.
# tests/fixtures/ is regenerable too, under its own README's regimes; the -text protection is shared.
producers/tests/OkfProducer.Tests/fixtures/** -text
