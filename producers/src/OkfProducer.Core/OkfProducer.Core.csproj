<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\OKF4net\OKF4net.csproj" />
  </ItemGroup>

  <!--
    DocCommentSource.UnwrapXmlDocTags reports a scan-cost step count that the public Describe path has
    no way to expose. That count is the executable guard on ScanTokens' early-out, which is
    behaviour-neutral and therefore invisible to any assertion about the text a description comes out
    as; without this the only evidence for it would be a wall-clock number in a comment.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="OkfProducer.Tests" />
  </ItemGroup>

  <!--
    E11: BoundedProcess (the one child-process runner) and BundlePaths' containment and link-walk
    helpers are shared by both code-graph engines, which used to carry private copies that drifted
    apart. Granted to exactly those two assemblies rather than made public: they are plumbing, not
    producer API, and a public type here would be one more thing a consumer of OkfProducer.Core
    could come to depend on.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="OkfProducer.CodeGraph.Roslyn" />
    <InternalsVisibleTo Include="OkfProducer.CodeGraph.TreeSitter" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
