<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OKF4net.Samples.AgentsHandoff</RootNamespace>
    <AssemblyName>AgentsHandoff</AssemblyName>
  </PropertyGroup>

  <!--
    Deliberately one ProjectReference and zero PackageReference, like
    samples/agents-quickstart: Microsoft.Agents.AI (and Microsoft.Extensions.AI
    behind it) and the OKF4net core arrive transitively through OKF4net.Agents,
    at exactly the versions it was built against. There is no OpenAI/Azure
    client here because there is no real model; see ScriptedChatClient.cs.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\OKF4net.Agents\OKF4net.Agents.csproj" />
  </ItemGroup>

</Project>
