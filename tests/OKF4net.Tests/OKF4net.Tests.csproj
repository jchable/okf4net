<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OKF4net\OKF4net.csproj" />
    <ProjectReference Include="..\..\src\OKF4net.Cli\OKF4net.Cli.csproj" />
    <ProjectReference Include="..\..\src\OKF4net.Agents\OKF4net.Agents.csproj" />
    <ProjectReference Include="..\..\src\OKF4net.Mcp\OKF4net.Mcp.csproj" />
    <ProjectReference Include="..\..\src\OKF4net.Render\OKF4net.Render.csproj" />
    <ProjectReference Include="..\..\src\OKF4net.Catalog\OKF4net.Catalog.csproj" />
    <ProjectReference Include="..\..\src\OKF4net.Catalog.Hosting\OKF4net.Catalog.Hosting.csproj" />
    <ProjectReference Include="..\..\src\OKF4net.Attestation\OKF4net.Attestation.csproj" />
    <ProjectReference Include="..\..\src\OKF4net.Attestation.Containers\OKF4net.Attestation.Containers.csproj" />
    <ProjectReference Include="..\..\src\OKF4net.Viewer\OKF4net.Viewer.csproj" />
    <ProjectReference Include="..\..\src\OKF4net.Providers.EmbeddedResources\OKF4net.Providers.EmbeddedResources.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Built, never referenced: Yaml/YamlHostileInputTests.cs runs it as a child
      process (dotnet YamlHostileProbe.dll <case>), so a stack overflow in the
      parser kills the probe and not the test host. This reference only makes
      every build of the tests build the probe first, in the same configuration.
    -->
    <ProjectReference Include="..\YamlHostileProbe\YamlHostileProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Embedded test bundles (spec §6.1-§6.3). The .targets is imported at the END
    of the body, after these items, so its evaluation-time Remove sees them —
    the names/ bundle holds a deliberately invalid x.cs and r.resx, and this
    project still builds only because they are neither compiled nor passed to
    ResGen. NuGet's own import order is covered by TargetsBuildTests and the
    AOT CI job.
  -->
  <ItemGroup>
    <OkfBundle Include="Providers\EmbeddedResources\Assets\contract\" Prefix="contract" />
    <OkfBundle Include="Providers\EmbeddedResources\Assets\contract2\" Prefix="contract2" />
    <OkfBundle Include="Providers\EmbeddedResources\Assets\names\" Prefix="names" />
    <!-- Parity (spec §6.3): embedded, never edited. -->
    <OkfBundle Include="..\fixtures\okf_v02\" Prefix="fixture-okf_v02" />
    <OkfBundle Include="..\fixtures\okf_v02_computation\" Prefix="fixture-okf_v02_computation" />
    <OkfBundle Include="..\fixtures\okf_v02_reserved\" Prefix="fixture-okf_v02_reserved" />
    <OkfBundle Include="..\fixtures\appendix_a\" Prefix="fixture-appendix_a" />
    <OkfBundle Include="..\..\bundles\acme_retail\" Prefix="acme_retail" />
    <!-- Not under the convention: GetBundlePrefixes must ignore them. Two files: one item per file (NETSDK1022 refuses a duplicate EmbeddedResource). -->
    <EmbeddedResource Include="Providers\EmbeddedResources\Assets\stray1.txt" LogicalName="okf:/stray.md" WithCulture="false" Type="Non-Resx" />
    <EmbeddedResource Include="Providers\EmbeddedResources\Assets\stray2.txt" LogicalName="okf:noslash" WithCulture="false" Type="Non-Resx" />
  </ItemGroup>

  <Import Project="..\..\src\OKF4net.Providers.EmbeddedResources\build\OKF4net.Providers.EmbeddedResources.targets" />

</Project>