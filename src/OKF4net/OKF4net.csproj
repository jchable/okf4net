<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Packaging">
    <PackageId>OKF4net</PackageId>
    <Authors>Julien CHABLE</Authors>
    <Description>Zero-dependency .NET implementation of the Open Knowledge Format (OKF) v0.2: parse, validate, index, and graph OKF knowledge bundles (markdown + YAML frontmatter).</Description>
    <Copyright>Copyright 2026 Julien CHABLE</Copyright>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/jchable/okf4net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jchable/okf4net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>okf;open-knowledge-format;knowledge;markdown;yaml;frontmatter;knowledge-graph</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.Apache-2.0" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project exercise internal helpers (e.g.
         UnicodeCaseFold) directly, without inflating the public API surface. -->
    <InternalsVisibleTo Include="OKF4net.Tests" />
    <!-- Lets OKF4net.Cli and OKF4net.Agents share the internal helpers in
         Internal/ (encodings, debug quoting, path ordering) without
         promoting them to public API. The CLI project's assembly name is
         "okf" (see OKF4net.Cli.csproj's AssemblyName), not "OKF4net.Cli":
         InternalsVisibleTo must match the actual assembly name. -->
    <InternalsVisibleTo Include="okf" />
    <InternalsVisibleTo Include="OKF4net.Agents" />
    <!-- Lets OKF4net.Catalog reuse the internal ReparsePoints helper instead
         of duplicating a platform-specific implementation. -->
    <InternalsVisibleTo Include="OKF4net.Catalog" />
    <!-- Lets OKF4net.Viewer reuse the internal ReparsePoints helper (its
         HtmlWriter output-directory containment guards) instead of
         duplicating a platform-specific implementation. -->
    <InternalsVisibleTo Include="OKF4net.Viewer" />
  </ItemGroup>

</Project>
