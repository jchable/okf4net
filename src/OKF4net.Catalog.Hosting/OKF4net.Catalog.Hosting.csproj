<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The one, explicit dependency-policy exception (see CLAUDE.md): this
         is the only project in the solution allowed a Microsoft.Extensions.*
         reference, scoped to the DI abstractions needed to register catalog
         sources with a host's IServiceCollection. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OKF4net.Catalog\OKF4net.Catalog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project exercise internal members directly, without
         inflating the public API surface. -->
    <InternalsVisibleTo Include="OKF4net.Tests" />
  </ItemGroup>

</Project>
