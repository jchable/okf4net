<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Not currently packed by .github/workflows/release.yml: this project
       ships to users only as code baked into the `okf-render` Native AOT
       binary (OKF4net.Render), a separate binary from `okf` itself, so the
       CI-facing validator does not carry this project's vendored viewer
       JavaScript. The metadata below is kept ready (inert until then) so
       publishing it as a standalone NuGet package later is a one-line change
       to that workflow, not a design decision, but that is a deliberate call
       the README currently reflects as unpublished; do not add it to
       release.yml without that decision being made explicitly. -->
  <PropertyGroup Label="Packaging">
    <PackageId>OKF4net.Viewer</PackageId>
    <Authors>Julien CHABLE</Authors>
    <Description>Static HTML site generation for OKF knowledge bundles: one page per concept, generated index, navigable cross-links, over the OKF4net format core.</Description>
    <Copyright>Copyright 2026 Julien CHABLE</Copyright>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/jchable/okf4net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jchable/okf4net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>okf;knowledge;viewer;static-site;html</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- LogicalName keeps each asset's path below Assets/ ("Assets/fonts/x.woff2"),
         so ViewerAssets can list every asset and HtmlWriter writes each one at
         the same path under assets/ (spec §12.0). %(RecursiveDir) carries the OS
         separator; ViewerAssets turns "\" into "/" when it reads the names.
         fonts/README.md records the fonts' provenance and is not an asset.
         Editor backups and OS litter (an untracked .orig, .bak, ~ or .swp
         file, .DS_Store, Thumbs.db) are never embedded: the wildcard would
         otherwise ship them in every generated site. -->
    <EmbeddedResource Include="Assets\**\*" Exclude="Assets\fonts\README.md;Assets\**\*.orig;Assets\**\*.bak;Assets\**\*~;Assets\**\*.swp;Assets\**\.DS_Store;Assets\**\Thumbs.db" LogicalName="Assets/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OKF4net\OKF4net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project exercise internal members directly: e.g.
         HtmlSafeJson, a page-shell implementation detail not listed among
         the spec's §5 units (SiteModel, HtmlWriter, ViewerAssets), without
         inflating the public API surface. -->
    <InternalsVisibleTo Include="OKF4net.Tests" />
  </ItemGroup>

</Project>
